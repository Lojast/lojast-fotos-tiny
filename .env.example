# Copie este arquivo para ".env" e preencha. O .env NUNCA vai para o GitHub.

# Token da API v2 do Tiny (Configurações, na parte de integrações/API do Tiny)
TINY_TOKEN=

# Repositório PÚBLICO onde as fotos tratadas ficam hospedadas (o Tiny baixa as fotos de lá)
FOTOS_REPO_GIT=https://github.com/SEU-USUARIO/SEU-REPO-DE-FOTOS.git
FOTOS_BASE_URL=https://raw.githubusercontent.com/SEU-USUARIO/SEU-REPO-DE-FOTOS/main

# Opcionais (valores padrão abaixo)
# LOGO_LOJA=assets/logo_lojast.png
# TERMOS=cabo,capa,fone
# MIN_FOTOS=3
# MAX_FOTOS=5
# LADO=1000
# PAUSA_TINY=2.2
